<Item class="StarterPlayer" referent="RBX38"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX36"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX34"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[--!nonstrict


local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Crystals = require(Shared:WaitForChild("Crystals"))
local Theme = UI.Theme

local HUD = {}

function HUD.init(ctx)
local player = ctx.player
local gui = ctx.gui




local gems = UI.panel(gui, { Name = "Gems", Size = UDim2.fromOffset(236, 64), Position = UDim2.fromOffset(16, 16), Border = Theme.Gold })
UI.gemIcon(gems.Content, 38, UDim2.fromOffset(12, 13), Theme.Border)
local gemsValue = UI.text(gems.Content, {
Text = "0", Size = UDim2.new(1, -66, 0, 30), Position = UDim2.fromOffset(58, 6),
TextSize = 26, Font = UI.FontBlack, XAlign = Enum.TextXAlignment.Left, TextColor = Theme.Gold,
})
local gemsRate = UI.text(gems.Content, {
Text = "+0 / sec", Size = UDim2.new(1, -66, 0, 18), Position = UDim2.fromOffset(58, 38),
TextSize = 14, XAlign = Enum.TextXAlignment.Left, TextColor = Theme.Green,
})

local strength = UI.panel(gui, { Name = "Strength", Size = UDim2.fromOffset(236, 56), Position = UDim2.fromOffset(16, 88), Border = Theme.Accent })
UI.dumbbellIcon(strength.Content, 38, UDim2.fromOffset(12, 9), Theme.Accent)
local strengthValue = UI.text(strength.Content, {
Text = "5 kg", Size = UDim2.new(1, -66, 0, 28), Position = UDim2.fromOffset(58, 4),
TextSize = 24, Font = UI.FontBlack, XAlign = Enum.TextXAlignment.Left,
})
UI.text(strength.Content, {
Text = "STRENGTH (max lift)", Size = UDim2.new(1, -66, 0, 16), Position = UDim2.fromOffset(58, 32),
TextSize = 12, XAlign = Enum.TextXAlignment.Left, TextColor = Theme.Muted,
})

local function refreshStats()
gemsValue.Text = Util.abbrev(player:GetAttribute("Gems") or 0)
strengthValue.Text = Util.comma(player:GetAttribute("Strength") or 0) .. " kg"
gemsRate.Text = "+" .. Util.abbrev(player:GetAttribute("Income") or 0) .. " / sec"
end
for _, name in { "Gems", "Strength", "Income" } do
player:GetAttributeChangedSignal(name):Connect(refreshStats)
end
refreshStats()




UI.button(gui, {
Text = "TRAIL SHOP", Size = UDim2.fromOffset(236, 44), Position = UDim2.fromOffset(16, 156),
Color = Theme.Bg2, Border = Theme.Accent, TextSize = 17,
OnClick = function()
ctx.Shop.toggle()
end,
})
local lockButton = UI.button(gui, {
Text = "LOCK BASE  [L]", Size = UDim2.fromOffset(236, 44), Position = UDim2.fromOffset(16, 208),
Color = Theme.Bg2, Border = Theme.Border, TextSize = 17,
OnClick = function()
ctx.Remotes.ToggleLock:FireServer()
end,
})




local carry = UI.panel(gui, {
Name = "Carry", Size = UDim2.fromOffset(420, 62), Position = UDim2.new(0.5, 0, 1, -24), AnchorPoint = Vector2.new(0.5, 1),
Border = Theme.Border,
})
carry.Root.Visible = false
local carryTitle = UI.text(carry.Content, {
Text = "", Size = UDim2.new(1, -140, 0, 26), Position = UDim2.fromOffset(16, 6),
TextSize = 18, Font = UI.FontBlack, XAlign = Enum.TextXAlignment.Left,
})
local carryDetail = UI.text(carry.Content, {
Text = "", Size = UDim2.new(1, -140, 0, 20), Position = UDim2.fromOffset(16, 32),
TextSize = 14, XAlign = Enum.TextXAlignment.Left, TextColor = Theme.Muted,
})
UI.button(carry.Content, {
Text = "DROP [G]", Size = UDim2.fromOffset(108, 40), Position = UDim2.new(1, -120, 0.5, -20),
Color = Theme.Bg3, Border = Theme.Red, TextSize = 15,
OnClick = function()
ctx.Remotes.DropCrystal:FireServer()
end,
})

local function refreshCarry()
local carrying = player:GetAttribute("Carrying") == true
carry.Root.Visible = carrying
if carrying then
local rarity = player:GetAttribute("CarryRarity") or "Common"
carryTitle.Text = tostring(player:GetAttribute("CarryName") or "Crystal")
carryTitle.TextColor3 = Crystals.RarityColors[rarity] or Theme.Text
carryDetail.Text = Util.formatWeight(player:GetAttribute("CarryWeight") or 0) .. "  -  take it to a pedestal in your base"
end
end
for _, name in { "Carrying", "CarryName", "CarryWeight", "CarryRarity" } do
player:GetAttributeChangedSignal(name):Connect(refreshCarry)
end
refreshCarry()




local function plotModel()
local index = player:GetAttribute("PlotIndex")
local map = workspace:FindFirstChild("Map")
local plots = map and map:FindFirstChild("Plots")
return index and plots and plots:FindFirstChild("Plot" .. index)
end

local lastText = ""
local lastMode = ""
local acc = 0
RunService.Heartbeat:Connect(function(dt)
acc += dt
if acc < 0.2 then
return
end
acc = 0
local plot = plotModel()
if not plot then
lockButton.Root.Visible = false
return
end
lockButton.Root.Visible = true
local now = workspace:GetServerTimeNow()
local locked = plot:GetAttribute("Locked") == true
local readyAt = plot:GetAttribute("LockReadyAt") or 0
local endsAt = plot:GetAttribute("LockEndsAt") or 0
local text, mode
if locked then
text = "LOCKED  " .. math.max(0, math.ceil(endsAt - now)) .. "s"
mode = "locked"
elseif now < readyAt then
text = "RECHARGING  " .. math.ceil(readyAt - now) .. "s"
mode = "cooldown"
else
text = "LOCK BASE  [L]"
mode = "ready"
end
if text ~= lastText then
lastText = text
lockButton.SetText(text)
end
if mode ~= lastMode then
lastMode = mode
if mode == "ready" then
lockButton.SetEnabled(true)
lockButton.SetColors(Theme.Bg2, nil, Theme.Border)
elseif mode == "locked" then
lockButton.SetColors(Color3.fromRGB(30, 70, 90), nil, Theme.Green)
lockButton.SetEnabled(false)
else
lockButton.SetEnabled(false)
end
end
end)




UserInputService.InputBegan:Connect(function(input, processed)
if processed then
return
end
if input.KeyCode == Enum.KeyCode.G then
ctx.Remotes.DropCrystal:FireServer()
elseif input.KeyCode == Enum.KeyCode.L then
ctx.Remotes.ToggleLock:FireServer()
end
end)
end

return HUD
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">Prompts</string><ProtectedString name="Source"><![CDATA[--!nonstrict







local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Crystals = require(Shared:WaitForChild("Crystals"))
local Theme = UI.Theme

local Prompts = {}

local ctx = nil
local player = nil




local function describe(prompt)
local kind = prompt:GetAttribute("Kind")
local part = prompt.Parent
local myId = player.UserId
local carrying = player:GetAttribute("Carrying") == true
local strength = player:GetAttribute("Strength") or 0

local info = {
Visible = true,
Action = prompt.ActionText,
Object = prompt.ObjectText,
Sub = "",
Color = Theme.Border,
}
if not part then
info.Visible = false
return info
end

if kind == "Crystal" then
local model = part.Parent
local weight = model and model:GetAttribute("Weight") or 0
info.Object = model and model:GetAttribute("CrystalName") or "Crystal"
info.Color = Crystals.RarityColors[model and model:GetAttribute("Rarity") or ""] or Theme.Border
if carrying then
info.Sub = "Your hands are full"
elseif weight > strength then
info.Sub = "TOO HEAVY - need " .. Util.comma(weight) .. " kg"
info.Color = Theme.Red
else
info.Sub = Util.formatWeight(weight)
end

elseif kind == "Pedestal" then
local ownerId = part:GetAttribute("OwnerUserId") or 0
local occupied = part:GetAttribute("Occupied") == true
local mine = ownerId == myId
if ctx.working or ownerId == 0 then
info.Visible = false
elseif occupied then
local cname = part:GetAttribute("CrystalName") or "Crystal"
local cweight = part:GetAttribute("CrystalWeight") or 0
if carrying then
info.Visible = false
elseif mine then
info.Action = "Pick Up"
info.Object = cname
info.Sub = Util.formatWeight(cweight)
info.Color = Theme.Green
else
info.Action = "STEAL"
info.Object = cname
info.Color = Theme.Red
local plotModel = part.Parent
if plotModel and plotModel:GetAttribute("Locked") == true then
info.Sub = "BASE LOCKED"
info.Color = Theme.Muted
elseif cweight > strength then
info.Sub = "TOO HEAVY - need " .. Util.comma(cweight) .. " kg"
else
info.Sub = Util.formatWeight(cweight)
end
end
elseif mine and carrying then
info.Action = "Place Crystal"
info.Object = player:GetAttribute("CarryName") or "Crystal"
info.Sub = Util.formatWeight(player:GetAttribute("CarryWeight") or 0)
info.Color = Theme.Green
else
info.Visible = false
end

elseif kind == "Gym" then
local ownerId = part:GetAttribute("OwnerUserId") or 0
local need = part:GetAttribute("MinStrength") or 0
if ctx.working or ownerId ~= myId then
info.Visible = false
elseif strength < need then
info.Sub = "Need " .. Util.comma(need) .. " kg strength"
info.Color = Theme.Red
else
info.Sub = "Hold to start"
info.Color = Theme.Accent
end

elseif kind == "Lock" then
local ownerId = part:GetAttribute("OwnerUserId") or 0
info.Visible = ownerId == myId and not ctx.working
info.Sub = "Keeps thieves out for a while"

elseif kind == "Shop" then
info.Sub = "Spend gems on trails"
info.Color = Theme.Accent
end

return info
end




local function startFilter()
local acc = 0
RunService.Heartbeat:Connect(function(dt)
acc += dt
if acc < 0.16 then
return
end
acc = 0
for _, prompt in CollectionService:GetTagged("DynPrompt") do
if prompt:IsA("ProximityPrompt") and prompt:GetAttribute("Kind") ~= "Crystal" then
local want = describe(prompt).Visible
if prompt.Enabled ~= want then
prompt.Enabled = want
end
end
end
end)
end




local function keyText(prompt, inputType)
if inputType == Enum.ProximityPromptInputType.Touch then
return "TAP"
elseif inputType == Enum.ProximityPromptInputType.Gamepad then
return (string.gsub(prompt.GamepadKeyCode.Name, "^Button", ""))
end
local ok, text = pcall(function()
return UserInputService:GetStringForKeyCode(prompt.KeyboardKeyCode)
end)
if ok and text and text ~= "" then
return text
end
return prompt.KeyboardKeyCode.Name
end

local function createPrompt(prompt, inputType, screen)
local info = describe(prompt)

local billboard = Instance.new("BillboardGui")
billboard.Name = "PromptUI"
billboard.Size = UDim2.fromOffset(270, 86)
billboard.StudsOffset = Vector3.new(0, 1.4, 0)
billboard.AlwaysOnTop = true
billboard.LightInfluence = 0
billboard.ResetOnSpawn = false
billboard.Active = true
billboard.Adornee = prompt.Parent
billboard.Parent = screen

local group = Instance.new("CanvasGroup")
group.BackgroundTransparency = 1
group.BorderSizePixel = 0
group.Size = UDim2.fromScale(1, 1)
group.GroupTransparency = 1
group.Parent = billboard

local panel = UI.panel(group, { Size = UDim2.fromScale(1, 1), Color = Theme.Bg, Border = info.Color, Cham = 10, Stroke = 3 })
local content = panel.Content


local badge = Instance.new("Frame")
badge.BorderSizePixel = 0
badge.AnchorPoint = Vector2.new(0.5, 0.5)
badge.Position = UDim2.fromOffset(46, 40)
badge.Size = UDim2.fromOffset(44, 44)
badge.Rotation = 45
badge.BackgroundColor3 = Theme.Bg3
badge.ZIndex = 6
badge.Parent = content
local badgeText = UI.text(content, {
Text = keyText(prompt, inputType), Size = UDim2.fromOffset(60, 30), Position = UDim2.fromOffset(16, 25),
TextSize = 20, Font = UI.FontBlack, Z = 8,
})

local action = UI.text(content, {
Text = info.Action, Size = UDim2.new(1, -100, 0, 26), Position = UDim2.fromOffset(86, 8),
TextSize = 21, Font = UI.FontBlack, XAlign = Enum.TextXAlignment.Left, TextColor = info.Color, Z = 8,
})
local object = UI.text(content, {
Text = info.Object, Size = UDim2.new(1, -100, 0, 20), Position = UDim2.fromOffset(86, 34),
TextSize = 15, XAlign = Enum.TextXAlignment.Left, Z = 8,
})
local sub = UI.text(content, {
Text = info.Sub, Size = UDim2.new(1, -100, 0, 16), Position = UDim2.fromOffset(86, 54),
TextSize = 12, XAlign = Enum.TextXAlignment.Left, TextColor = Theme.Muted, Z = 8,
})
for _, l in { action, object, sub } do
l.TextTruncate = Enum.TextTruncate.AtEnd
end


local track = Instance.new("Frame")
track.BorderSizePixel = 0
track.BackgroundColor3 = Color3.fromRGB(16, 18, 34)
track.Size = UDim2.new(1, -28, 0, 5)
track.Position = UDim2.new(0, 14, 1, -11)
track.ZIndex = 7
track.Visible = prompt.HoldDuration > 0
track.Parent = content
local fill = Instance.new("Frame")
fill.BorderSizePixel = 0
fill.BackgroundColor3 = info.Color
fill.Size = UDim2.fromScale(0, 1)
fill.ZIndex = 8
fill.Parent = track

local connections = {}
local holding = false
local holdTween = nil

local function startHold()
if holding or prompt.HoldDuration <= 0 then
return
end
holding = true
fill.Size = UDim2.fromScale(0, 1)
holdTween = UI.tween(fill, prompt.HoldDuration, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Linear)
end
local function stopHold()
holding = false
if holdTween then
holdTween:Cancel()
holdTween = nil
end
fill.Size = UDim2.fromScale(0, 1)
end

table.insert(connections, prompt.PromptButtonHoldBegan:Connect(startHold))
table.insert(connections, prompt.PromptButtonHoldEnded:Connect(stopHold))
table.insert(connections, prompt.Triggered:Connect(stopHold))
table.insert(connections, prompt.TriggerEnded:Connect(stopHold))


if inputType == Enum.ProximityPromptInputType.Keyboard then
table.insert(connections, UserInputService.InputBegan:Connect(function(input)
if input.KeyCode == prompt.KeyboardKeyCode then
startHold()
end
end))
table.insert(connections, UserInputService.InputEnded:Connect(function(input)
if input.KeyCode == prompt.KeyboardKeyCode then
stopHold()
end
end))
end


if inputType == Enum.ProximityPromptInputType.Touch or prompt.ClickablePrompt then
local hit = Instance.new("TextButton")
hit.BackgroundTransparency = 1
hit.Text = ""
hit.Size = UDim2.fromScale(1, 1)
hit.ZIndex = 20
hit.Parent = content
table.insert(connections, hit.InputBegan:Connect(function(input)
if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1)
and input.UserInputState ~= Enum.UserInputState.Change then
prompt:InputHoldBegin()
end
end))
table.insert(connections, hit.InputEnded:Connect(function(input)
if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
prompt:InputHoldEnd()
end
end))
end


table.insert(connections, RunService.Heartbeat:Connect(function()
local now = describe(prompt)
if action.Text ~= now.Action then
action.Text = now.Action
end
if object.Text ~= now.Object then
object.Text = now.Object
end
if sub.Text ~= now.Sub then
sub.Text = now.Sub
end
if action.TextColor3 ~= now.Color then
action.TextColor3 = now.Color
fill.BackgroundColor3 = now.Color
panel.SetBorder(now.Color)
end
end))

UI.tween(group, 0.15, { GroupTransparency = 0 })
badgeText.TextColor3 = Theme.Text

prompt.PromptHidden:Wait()

for _, c in connections do
c:Disconnect()
end
stopHold()
local fade = UI.tween(group, 0.12, { GroupTransparency = 1 })
fade.Completed:Wait()
billboard:Destroy()
end

function Prompts.init(c)
ctx = c
player = c.player

local screen = UI.screenGui("Prompts", 5)

ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
if prompt.Style == Enum.ProximityPromptStyle.Default then
return
end
task.spawn(createPrompt, prompt, inputType, screen)
end)

startFilter()
end

return Prompts
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[--!nonstrict


local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Trails = require(Shared:WaitForChild("Trails"))
local Theme = UI.Theme

local Shop = {}

local window = nil
local refresh = nil

function Shop.open()
if window then
window.Root.Visible = true
if refresh then
refresh()
end
end
end

function Shop.close()
if window then
window.Root.Visible = false
end
end

function Shop.toggle()
if window then
if window.Root.Visible then
Shop.close()
else
Shop.open()
end
end
end

function Shop.init(ctx)
local player = ctx.player

window = UI.panel(ctx.gui, {
Name = "TrailShop",
Size = UDim2.fromOffset(660, 470),
Position = UDim2.fromScale(0.5, 0.5),
AnchorPoint = Vector2.new(0.5, 0.5),
Color = Theme.Bg,
Border = Theme.Accent,
Cham = 14,
Stroke = 4,
Z = 20,
})
window.Root.Visible = false
local content = window.Content

UI.text(content, {
Text = "TRAIL SHOP", Size = UDim2.fromOffset(300, 40), Position = UDim2.fromOffset(24, 14),
TextSize = 28, Font = UI.FontBlack, XAlign = Enum.TextXAlignment.Left, TextColor = Theme.Accent, Z = 22,
})
UI.text(content, {
Text = "Leave a glowing trail behind you. Earn gems from the crystals in your base.", Size = UDim2.fromOffset(470, 18),
Position = UDim2.fromOffset(24, 50), TextSize = 13, XAlign = Enum.TextXAlignment.Left, TextColor = Theme.Muted, Z = 22,
})
local gemsLabel = UI.text(content, {
Text = "0", Size = UDim2.fromOffset(150, 28), Position = UDim2.new(1, -230, 0, 18),
TextSize = 22, Font = UI.FontBlack, XAlign = Enum.TextXAlignment.Right, TextColor = Theme.Gold, Z = 22,
})
UI.gemIcon(content, 28, UDim2.new(1, -74, 0, 18), Theme.Border)
UI.button(content, {
Text = "X", Size = UDim2.fromOffset(36, 36), Position = UDim2.new(1, -46, 0, 12),
Color = Theme.Bg3, Border = Theme.Red, TextSize = 18, Z = 22,
OnClick = Shop.close,
})

local scroll = Instance.new("ScrollingFrame")
scroll.Name = "List"
scroll.BackgroundTransparency = 1
scroll.BorderSizePixel = 0
scroll.Size = UDim2.new(1, -40, 1, -92)
scroll.Position = UDim2.fromOffset(20, 76)
scroll.ScrollBarThickness = 6
scroll.ScrollBarImageColor3 = Theme.Accent
scroll.CanvasSize = UDim2.new()
scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
scroll.ScrollingDirection = Enum.ScrollingDirection.Y
scroll.ZIndex = 22
scroll.Parent = content

local grid = Instance.new("UIGridLayout")
grid.CellSize = UDim2.fromOffset(192, 150)
grid.CellPadding = UDim2.fromOffset(10, 10)
grid.SortOrder = Enum.SortOrder.LayoutOrder
grid.Parent = scroll
local pad = Instance.new("UIPadding")
pad.PaddingRight = UDim.new(0, 8)
pad.PaddingBottom = UDim.new(0, 8)
pad.Parent = scroll

local cards = {}

local function act(action, id)
task.spawn(function()
local ok, message = ctx.Remotes.ShopAction:InvokeServer(action, id)
ctx.Toast.show(tostring(message or ""), if ok then "good" else "bad")
refresh()
end)
end

for order, def in Trails.List do
local card = UI.panel(scroll, {
Name = def.Id, Size = UDim2.fromOffset(192, 150), Color = Theme.Bg2, Border = Theme.Bg3, Cham = 9, Stroke = 2, Z = 23, LayoutOrder = order,
})

local preview = Instance.new("Frame")
preview.Name = "Preview"
preview.BorderSizePixel = 0
preview.BackgroundColor3 = Color3.new(1, 1, 1)
preview.Size = UDim2.new(1, -28, 0, 28)
preview.Position = UDim2.fromOffset(14, 14)
preview.ZIndex = 26
preview.Parent = card.Content
local gradient = Instance.new("UIGradient")
gradient.Color = Trails.sequence(def)
gradient.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.7) })
gradient.Parent = preview
local tip = Instance.new("Frame")
tip.BorderSizePixel = 0
tip.AnchorPoint = Vector2.new(0.5, 0.5)
tip.Size = UDim2.fromOffset(20, 20)
tip.Rotation = 45
tip.BackgroundColor3 = def.Colors[1][2]
tip.Position = UDim2.new(0, 14, 0, 14 + 14)
tip.ZIndex = 27
tip.Parent = card.Content

UI.text(card.Content, {
Text = def.Name, Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 50),
TextSize = 17, Font = UI.FontBlack, Z = 26,
})
local priceLabel = UI.text(card.Content, {
Text = "", Size = UDim2.new(1, -20, 0, 18), Position = UDim2.fromOffset(10, 72),
TextSize = 14, TextColor = Theme.Gold, Z = 26,
})
local button = UI.button(card.Content, {
Text = "BUY", Size = UDim2.new(1, -28, 0, 36), Position = UDim2.new(0, 14, 1, -48),
Color = Theme.Bg3, Border = Theme.Gold, TextSize = 15, Z = 26,
OnClick = function()
local owned = Util.setFromList(Util.split(player:GetAttribute("Trails")))
if player:GetAttribute("Equipped") == def.Id then
act("Unequip", def.Id)
elseif owned[def.Id] then
act("Equip", def.Id)
else
act("Buy", def.Id)
end
end,
})
cards[def.Id] = { Card = card, Price = priceLabel, Button = button, Def = def }
end

refresh = function()
gemsLabel.Text = Util.comma(player:GetAttribute("Gems") or 0)
local owned = Util.setFromList(Util.split(player:GetAttribute("Trails")))
local equipped = player:GetAttribute("Equipped") or ""
local gems = player:GetAttribute("Gems") or 0
for id, c in cards do
if equipped == id then
c.Price.Text = "EQUIPPED"
c.Price.TextColor3 = Theme.Green
c.Button.SetText("UNEQUIP")
c.Button.SetEnabled(true)
c.Button.SetColors(Theme.Bg3, nil, Theme.Green)
c.Card.SetBorder(Theme.Green)
elseif owned[id] then
c.Price.Text = "OWNED"
c.Price.TextColor3 = Theme.Border
c.Button.SetText("EQUIP")
c.Button.SetEnabled(true)
c.Button.SetColors(Theme.Bg3, nil, Theme.Border)
c.Card.SetBorder(Theme.Bg3)
else
c.Price.Text = if c.Def.Price == 0 then "FREE" else (Util.comma(c.Def.Price) .. " gems")
c.Price.TextColor3 = Theme.Gold
c.Card.SetBorder(Theme.Bg3)
if gems >= c.Def.Price then
c.Button.SetText("BUY")
c.Button.SetEnabled(true)
c.Button.SetColors(Theme.Bg3, nil, Theme.Gold)
else
c.Button.SetText("NEED MORE")
c.Button.SetEnabled(false)
end
end
end
end

for _, name in { "Gems", "Trails", "Equipped" } do
player:GetAttributeChangedSignal(name):Connect(function()
if window.Root.Visible then
refresh()
end
end)
end

ctx.Remotes.OpenShop.OnClientEvent:Connect(Shop.open)
refresh()
end

return Shop
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">Toast</string><ProtectedString name="Source"><![CDATA[--!nonstrict


local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("UI"))
local Theme = UI.Theme

local Toast = {}

local container = nil
local counter = 0

local KIND_COLORS = {
good = Theme.Green,
bad = Theme.Red,
warn = Theme.Gold,
info = Theme.Border,
}

function Toast.show(text, kind)
if not container then
return
end
counter += 1
local color = KIND_COLORS[kind or "info"] or Theme.Border

local group = Instance.new("CanvasGroup")
group.Name = "Toast"
group.BackgroundTransparency = 1
group.BorderSizePixel = 0
group.Size = UDim2.new(1, 0, 0, 46)
group.LayoutOrder = counter
group.GroupTransparency = 1
group.Parent = container

local panel = UI.panel(group, { Size = UDim2.fromScale(1, 1), Color = Theme.Bg, Border = color, Cham = 7, Stroke = 2 })
UI.text(panel.Content, {
Text = text,
Size = UDim2.new(1, -24, 1, 0),
Position = UDim2.fromOffset(12, 0),
TextSize = 15,
Wrapped = true,
})

UI.tween(group, 0.18, { GroupTransparency = 0 })


local kids = {}
for _, c in container:GetChildren() do
if c:IsA("CanvasGroup") then
table.insert(kids, c)
end
end
table.sort(kids, function(a, b)
return a.LayoutOrder < b.LayoutOrder
end)
while #kids > 5 do
table.remove(kids, 1):Destroy()
end

task.delay(3.8, function()
if group.Parent then
local t = UI.tween(group, 0.35, { GroupTransparency = 1 })
t.Completed:Connect(function()
group:Destroy()
end)
end
end)
end

function Toast.init(ctx)
container = Instance.new("Frame")
container.Name = "Toasts"
container.BackgroundTransparency = 1
container.Size = UDim2.fromOffset(440, 320)
container.Position = UDim2.new(0.5, 0, 0, 74)
container.AnchorPoint = Vector2.new(0.5, 0)
container.Parent = ctx.gui

local layout = Instance.new("UIListLayout")
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
layout.VerticalAlignment = Enum.VerticalAlignment.Top
layout.Padding = UDim.new(0, 6)
layout.Parent = container

ctx.Remotes.Notify.OnClientEvent:Connect(function(text, kind)
Toast.show(tostring(text), kind)
end)


local banner = UI.panel(ctx.gui, {
Name = "Announcement",
Size = UDim2.fromOffset(560, 64),
Position = UDim2.new(0.5, 0, 0, -90),
AnchorPoint = Vector2.new(0.5, 0),
Color = Theme.Bg,
Border = Theme.Gold,
Cham = 10,
Stroke = 3,
})
local bannerText = UI.text(banner.Content, {
Text = "",
Size = UDim2.new(1, -30, 1, 0),
Position = UDim2.fromOffset(15, 0),
TextSize = 20,
Font = UI.FontBlack,
TextColor = Theme.Gold,
Wrapped = true,
})
local token = 0
ctx.Remotes.Announce.OnClientEvent:Connect(function(text)
token += 1
local mine = token
bannerText.Text = tostring(text)
UI.tween(banner.Root, 0.35, { Position = UDim2.new(0.5, 0, 0, 16) }, Enum.EasingStyle.Back)
task.delay(7, function()
if token == mine then
UI.tween(banner.Root, 0.35, { Position = UDim2.new(0.5, 0, 0, -90) })
end
end)
end)
end

return Toast
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">Workout</string><ProtectedString name="Source"><![CDATA[--!nonstrict


local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UI = require(Shared:WaitForChild("UI"))
local Config = require(Shared:WaitForChild("Config"))
local Theme = UI.Theme

local Workout = {}

function Workout.init(ctx)
local active = false
local lastPress = 0

local panel = UI.panel(ctx.gui, {
Name = "Workout", Size = UDim2.fromOffset(520, 196), Position = UDim2.new(0.5, 0, 1, -24), AnchorPoint = Vector2.new(0.5, 1),
Color = Theme.Bg, Border = Theme.Green, Cham = 12, Stroke = 3, Z = 10,
})
panel.Root.Visible = false
local content = panel.Content

local title = UI.text(content, {
Text = "WORKOUT", Size = UDim2.new(1, -150, 0, 28), Position = UDim2.fromOffset(20, 10),
TextSize = 22, Font = UI.FontBlack, XAlign = Enum.TextXAlignment.Left, Z = 12,
})
local sub = UI.text(content, {
Text = "", Size = UDim2.new(1, -150, 0, 18), Position = UDim2.fromOffset(20, 38),
TextSize = 13, XAlign = Enum.TextXAlignment.Left, TextColor = Theme.Muted, Z = 12,
})
UI.button(content, {
Text = "STOP [X]", Size = UDim2.fromOffset(110, 34), Position = UDim2.new(1, -126, 0, 12),
Color = Theme.Bg3, Border = Theme.Red, TextSize = 14, Z = 12,
OnClick = function()
ctx.Remotes.WorkoutStop:FireServer()
end,
})


local track = UI.panel(content, {
Name = "Track", Size = UDim2.new(1, -40, 0, 34), Position = UDim2.fromOffset(20, 68),
Color = Color3.fromRGB(18, 20, 38), Border = Theme.Bg3, Cham = 6, Stroke = 2, Shine = false, Z = 12,
})
local lane = Instance.new("Frame")
lane.Name = "Lane"
lane.BackgroundTransparency = 1
lane.Size = UDim2.new(1, -16, 1, 0)
lane.Position = UDim2.fromOffset(8, 0)
lane.ZIndex = 16
lane.Parent = track.Content

local function zone(width, color, z)
local f = Instance.new("Frame")
f.BorderSizePixel = 0
f.AnchorPoint = Vector2.new(0.5, 0.5)
f.Position = UDim2.fromScale(0.5, 0.5)
f.Size = UDim2.new(width, 0, 1, -10)
f.BackgroundColor3 = color
f.ZIndex = z
f.Parent = lane
return f
end
zone(Config.GymGoodZone, Theme.Gold:Lerp(Color3.new(0, 0, 0), 0.35), 17)
local perfect = zone(Config.GymPerfectZone, Theme.Green, 18)

local marker = Instance.new("Frame")
marker.Name = "Marker"
marker.BorderSizePixel = 0
marker.AnchorPoint = Vector2.new(0.5, 0.5)
marker.Size = UDim2.fromOffset(18, 18)
marker.Rotation = 45
marker.BackgroundColor3 = Color3.new(1, 1, 1)
marker.Position = UDim2.fromScale(0, 0.5)
marker.ZIndex = 20
marker.Parent = lane
local markerLine = Instance.new("Frame")
markerLine.BorderSizePixel = 0
markerLine.AnchorPoint = Vector2.new(0.5, 0.5)
markerLine.Size = UDim2.new(0, 3, 1, 4)
markerLine.Position = UDim2.fromScale(0, 0.5)
markerLine.BackgroundColor3 = Color3.new(1, 1, 1)
markerLine.ZIndex = 19
markerLine.Parent = lane

local liftButton = UI.button(content, {
Text = "LIFT  [SPACE]", Size = UDim2.new(1, -40, 0, 56), Position = UDim2.fromOffset(20, 118),
Color = Color3.fromRGB(40, 110, 80), Border = Theme.Green, TextSize = 22, Font = UI.FontBlack, Cham = 9, Z = 12,
})

local feedback = UI.text(ctx.gui, {
Text = "", Size = UDim2.fromOffset(420, 44), Position = UDim2.new(0.5, 0, 1, -250), AnchorPoint = Vector2.new(0.5, 1),
TextSize = 32, Font = UI.FontBlack, Z = 30,
})
feedback.TextStrokeTransparency = 0.2
feedback.TextStrokeColor3 = Color3.fromRGB(10, 10, 25)
feedback.Visible = false
local feedbackToken = 0

local function press()
if not active then
return
end
local now = workspace:GetServerTimeNow()
if now - lastPress < Config.GymRepCooldown * 0.8 then
return
end
lastPress = now
ctx.Remotes.WorkoutRep:FireServer(now)
liftButton.SetEnabled(false)
task.delay(Config.GymRepCooldown, function()
if active then
liftButton.SetEnabled(true)
end
end)
end


liftButton.Button.MouseButton1Click:Connect(press)

UserInputService.InputBegan:Connect(function(input, processed)
if not active or processed then
return
end
if input.KeyCode == Enum.KeyCode.Space then
press()
elseif input.KeyCode == Enum.KeyCode.X then
ctx.Remotes.WorkoutStop:FireServer()
end
end)

RunService.RenderStepped:Connect(function()
if not active then
return
end
local pos = Config.GymBarPosition(workspace:GetServerTimeNow())
marker.Position = UDim2.fromScale(pos, 0.5)
markerLine.Position = UDim2.fromScale(pos, 0.5)
end)

local function show(text, color)
feedbackToken += 1
local mine = feedbackToken
feedback.Text = text
feedback.TextColor3 = color
feedback.Visible = true
feedback.Position = UDim2.new(0.5, 0, 1, -230)
UI.tween(feedback, 0.5, { Position = UDim2.new(0.5, 0, 1, -262) })
task.delay(0.9, function()
if feedbackToken == mine then
feedback.Visible = false
end
end)
end

ctx.Remotes.WorkoutStart.OnClientEvent:Connect(function(info)
active = true
ctx.working = true
lastPress = 0
title.Text = string.upper(tostring(info.Name))
sub.Text = "Hit the green zone for bonus strength. Chain hits for a combo!  +" .. tostring(info.Gain) .. " base"
liftButton.SetEnabled(true)
panel.Root.Visible = true
end)

ctx.Remotes.WorkoutEnd.OnClientEvent:Connect(function()
active = false
ctx.working = false
panel.Root.Visible = false
feedback.Visible = false
end)

ctx.Remotes.WorkoutResult.OnClientEvent:Connect(function(grade, gain, combo)
if grade == "Perfect" then
show("PERFECT  +" .. tostring(gain) .. (if combo > 1 then ("   x" .. tostring(combo)) else ""), Theme.Green)
UI.tween(perfect, 0.1, { BackgroundColor3 = Color3.new(1, 1, 1) }).Completed:Connect(function()
UI.tween(perfect, 0.25, { BackgroundColor3 = Theme.Green })
end)
elseif grade == "Good" then
show("GOOD  +" .. tostring(gain) .. (if combo > 1 then ("   x" .. tostring(combo)) else ""), Theme.Gold)
else
show("MISS", Theme.Red)
end
end)
end

return Workout
]]></ProtectedString></Properties></Item></Item><Item class="LocalScript" referent="RBX35"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!nonstrict




local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")




local messageLines = {}
local messageGui = nil
local messageBody = nil

local function showProblem(text)
table.insert(messageLines, text)
if not messageGui then
messageGui = Instance.new("ScreenGui")
messageGui.Name = "StealACrystalClientError"
messageGui.ResetOnSpawn = false
messageGui.IgnoreGuiInset = true
messageGui.DisplayOrder = 999

local box = Instance.new("TextButton")
box.Text = ""
box.AutoButtonColor = false
box.AnchorPoint = Vector2.new(0.5, 1)
box.Position = UDim2.new(0.5, 0, 1, -24)
box.Size = UDim2.new(0.9, 0, 0, 0)
box.AutomaticSize = Enum.AutomaticSize.Y
box.BackgroundColor3 = Color3.fromRGB(44, 12, 22)
box.BorderSizePixel = 0
box.Parent = messageGui
local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(255, 95, 115)
stroke.Thickness = 3
stroke.Parent = box
local pad = Instance.new("UIPadding")
pad.PaddingTop = UDim.new(0, 12)
pad.PaddingBottom = UDim.new(0, 12)
pad.PaddingLeft = UDim.new(0, 14)
pad.PaddingRight = UDim.new(0, 14)
pad.Parent = box

messageBody = Instance.new("TextLabel")
messageBody.BackgroundTransparency = 1
messageBody.Size = UDim2.new(1, 0, 0, 0)
messageBody.AutomaticSize = Enum.AutomaticSize.Y
messageBody.Font = Enum.Font.GothamMedium
messageBody.TextSize = 16
messageBody.TextWrapped = true
messageBody.TextXAlignment = Enum.TextXAlignment.Left
messageBody.TextColor3 = Color3.fromRGB(245, 245, 255)
messageBody.Parent = box

box.Activated:Connect(function()
messageGui:Destroy()
messageGui = nil
messageLines = {}
end)
messageGui.Parent = playerGui
end
messageBody.Text = "Steal a Crystal (screen side):\n" .. table.concat(messageLines, "\n") .. "\n\n(tap to close)"
end

local function safe(label, fn)
local ok, err = xpcall(fn, debug.traceback)
if not ok then
warn("[Steal a Crystal] " .. label .. " failed:\n" .. tostring(err))
showProblem("- " .. label .. " failed: " .. string.sub(tostring(err), 1, 260))
end
return ok
end




local loaded = false
task.delay(25, function()
if not loaded then
showProblem("- Still loading after 25 seconds. The game server probably did not start. "
.. "In Roblox Studio open the Output window (View > Output) and check the red messages. "
.. "Make sure you opened StealACrystal.rbxlx with File > Open from File.")
end
end)

local Shared = ReplicatedStorage:WaitForChild("Shared", 20)
local Remotes = ReplicatedStorage:WaitForChild("Remotes", 20)
local Client = script.Parent:WaitForChild("Client", 20)
if not (Shared and Remotes and Client) then
local missing = {}
if not Shared then table.insert(missing, "ReplicatedStorage.Shared") end
if not Remotes then table.insert(missing, "ReplicatedStorage.Remotes (made by the server)") end
if not Client then table.insert(missing, "StarterPlayerScripts.Client") end
showProblem("- Could not find: " .. table.concat(missing, ", "))
return
end

pcall(function()
StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

local UI
if not safe("loading the UI kit", function()
UI = require(Shared:WaitForChild("UI", 10))
require(Shared:WaitForChild("Remotes", 10))
end) then
return
end

local gui = UI.screenGui("StealACrystalUI", 2)
UI.autoScale(gui)

local ctx = {
player = player,
gui = gui,
Remotes = require(Shared.Remotes),
working = false,
}

local ORDER = { "Toast", "HUD", "Shop", "Workout", "Prompts" }
for _, name in ORDER do
safe("loading " .. name, function()
ctx[name] = require(Client:WaitForChild(name, 10))
end)
end
for _, name in ORDER do
if ctx[name] then
safe(name .. " setup", function()
ctx[name].init(ctx)
end)
end
end

loaded = true
]]></ProtectedString></Properties></Item></Item><Item class="StarterCharacterScripts" referent="RBX37"><Properties><string name="Name">StarterCharacterScripts</string></Properties></Item></Item>
</roblox>
